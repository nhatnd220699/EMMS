@using System.Web
@{
    ViewBag.Title = "Fixture Management";
    var currentRoleFromSession = (Session["CurrentRole"] ?? "uploader").ToString();
    var currentUserIdFromSession = (Session["UserId"] ?? "").ToString();
    var currentUserNameFromSession = (Session["UserName"] ?? "").ToString();
    var roleFromSession = (Session["Role"] ?? "").ToString();
}

@section styles {
    <link href="~/Content/css/fancybox/fancybox.css" rel="stylesheet" />
    <link href="~/Content/css/custom/style.css" rel="stylesheet" />
    <style>
        .kpi-inner {
            border-radius: 0.575rem;
            background-color: #ffffff;
/*            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);*/
            box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 4px 12px rgba(16, 24, 40, 0.06);
        }

        .kpi-card {
            height: 100%;
            border: 1px solid #efefef;
        }
    </style>
}
<main id="content" class="active">
    <div class="container-fluid px-4 py-3">
        <!-- KPI Statistics -->
        <div class="row mb-4">
            <div class="col-12 col-md-6 col-lg-7 mh-100">
                <div class="h-100 px-3 py-3 kpi-inner">
                    <div class="row mx-0 h-100 w-100 d-flex justify-content-between">
                        <div class="col-12 col-md-6 col-lg-6 h-50 py-2">
                            <div class="card kpi-card p-4" data-status="@Language.StatusAll">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-uppercase text-secondary fw-bold"
                                               style="font-size: 12px">
                                            @Language.TotalMaintenance
                                        </small>
                                        <h3 class="mb-0 fw-bold" id="kpi-total">0</h3>
                                    </div>
                                    <div class="kpi-icon-box bg-primary-subtle text-primary">
                                        <span class="material-symbols-outlined">inventory_2</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-6 h-50 py-2">
                            <div class="card kpi-card p-4" data-status="@Language.StatusNoMaintenance">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-uppercase text-secondary fw-bold" style="font-size: 12px">
                                            @Language.NoMaintenance
                                        </small>
                                        <h3 class="mb-0 fw-bold text-danger" id="kpi-maintenance">
                                            0
                                        </h3>
                                    </div>
                                    <div class="kpi-icon-box bg-danger-subtle text-danger">
                                        <span class="material-symbols-outlined">error</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-6 h-50 py-2">
                            <div class="card kpi-card p-4" data-status="@Language.StatusOngoing">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-uppercase text-secondary fw-bold"
                                               style="font-size: 12px">
                                            @Language.MaintenanceOngoing
                                        </small>
                                        <!-- <h4 class="mb-0 fw-bold" id="kpi-waiting" style="color: var(--tertiary);">0</h4> -->
                                        <h3 class="mb-0 fw-bold text-warning" id="kpi-waiting">
                                            0
                                        </h3>
                                    </div>
                                    <div class="kpi-icon-box bg-warning-subtle text-warning">
                                        <span class="material-symbols-outlined">schedule</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-6 h-50 py-2">
                            <div class="card kpi-card p-4" data-status="@Language.StatusDone">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-uppercase text-secondary fw-bold"
                                               style="font-size: 12px">
                                            @Language.MaintenanceDone
                                        </small>
                                        <h3 class="mb-0 fw-bold text-success" id="kpi-completed">
                                            0
                                        </h3>
                                    </div>
                                    <div class="kpi-icon-box bg-success-subtle text-success">
                                        <span class="material-symbols-outlined">check_circle</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-5">
                <div class="kpi-inner">
                    <div id="chartKpis" style="height: 400px;"></div>
                </div>
            </div>
        </div>
        <!-- Filters -->
        <div class="card border-0 shadow-sm p-2 mb-4">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <small class="text-uppercase text-secondary fw-bold ps-2"
                       style="font-size: 10px; letter-spacing: 1px">
                    @Language.Filter
                </small>
                <select class="form-select form-select-sm w-auto border-light-subtle bg-light" id="type">
                    <option value="">All type</option>
                </select>
                <select class="form-select form-select-sm w-auto border-light-subtle bg-light" id="line">
                    <option value="">All line</option>
                </select>
                <select class="form-select form-select-sm w-auto border-light-subtle bg-light" id="department">
                    <option value="">All dept</option>
                </select>
                <input type="text" class="form-control form-control-sm w-auto" id="fixture-sn" placeholder="@Language.EnterFixtureSN..." />
                <button class="btn btn-primary btn-sm ms-auto d-flex align-items-center gap-2" id="refresh-btn">
                    <span class="material-symbols-outlined fs-6">refresh</span> @Language.Refresh
                </button>
            </div>
        </div>
        <!-- Status Grid Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                @Language.Machines
                <small class="text-muted fw-normal ms-2 fs-6" id="grid-density-label">All</small>
            </h5>
            <div class="text-muted small" id="quick-pagination-info"></div>
        </div>
        <!-- Main Fixture Grid -->
        <div class="row g-3 mb-4" id="fixture-grid">
            <!-- Dynamically Rendered Content -->
        </div>
        <!-- Pagination Container -->
        <div class="pagination-bar d-flex flex-wrap align-items-center justify-content-between gap-3"
             id="pagination-container">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <small class="text-secondary fw-semibold">@Language.Show</small>
                    <select class="form-select form-select-sm border-light-subtle bg-light"
                            id="pageSizeSelector" style="width: 70px">
                        <option value="24">24</option>
                        <option value="30">30</option>
                        <option value="40">40</option>
                        <option value="54">54</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                </div>
                <div class="small text-secondary fw-medium" id="pageIndicator">
                    @Language.Showing 1 - 54 @Language.Of 0
                </div>
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0 flex-wrap gap-2" id="paginationControls">
                    <!-- Dynamically Rendered Pagination -->
                </ul>
            </nav>
        </div>
    </div>
</main>

<!-- Maintenance Log Modal -->
<div aria-hidden="true" class="modal" id="maintenanceModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px">
            <div class="modal-header px-4 py-3 border-bottom-0">
                <div>
                    <h5 class="fw-bold mb-1" id="maintenanceModalLabel">Machine</h5>
                    <p class="text-muted small mb-0" id="modalFixtureId">Fixture ID: --</p>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto me-3">
                    <label class="small text-muted fw-semibold mb-0" for="monthlyReportMonth">@Language.Month:</label>
                    <input class="form-control form-control-sm" id="monthlyReportMonth" style="width: 150px" type="month" />
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="monthlyReportSearchBtn" type="button">
                        <span class="material-symbols-outlined fs-6">search</span>
                        @Language.Search
                    </button>
                </div>
                <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
            </div>
            <div class="modal-body px-3 py-0">
                <div class="table-responsive-custom">
                    <table class="maintenance-table" id="maintenance-table">
                        <thead>
                            <tr>
                                <th colspan="34">
                                    @Language.DailyMaintenanceList
                                </th>
                            </tr>
                            <tr>
                                <th colspan="2" class="text-start">
                                    @Language.Line:
                                    <span id="modalLine"></span>
                                </th>
                                <th colspan="1" class="text-start">
                                    @Language.Shift:
                                    <span id="modalShift"></span>
                                </th>

                                <th colspan="20" class="text-start">
                                    @Language.Year:
                                    <span id="modalYear"></span>
                                </th>
                                <th colspan="11" class="text-start">
                                    @Language.Month:
                                    <span id="modalMonth"></span>
                                </th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-start">
                                    @Language.DeviceName:
                                    <span id="modalDeviceName"></span>
                                </th>
                                <th colspan="16" class="text-start">
                                    @Language.DeviceModel:
                                    <span id="modalDeviceMod"></span>
                                </th>
                                <th colspan="15" class="text-start">
                                    @Language.DeviceNumber:
                                    <span id="modalDeviceNo"></span>
                                </th>
                            </tr>
                            <tr>
                                <th rowspan="2" style="width: 40px">@Language.NoNumber</th>
                                <th rowspan="2" style="width: 220px">
                                    @Language.Action
                                </th>
                                <th rowspan="2" style="width: 220px">
                                    @Language.ConfirmationMethodAndStandard
                                </th>
                                <th colspan="31">@Language.Date</th>
                            </tr>
                            <tr id="date-header-row">
                                <!-- Days 1 to 31 will be injected here via JS -->
                            </tr>
                        </thead>
                        <tbody id="maintenance-body"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button class="btn px-3 py-2 transition-all shadow-sm fw-semibold" data-bs-dismiss="modal"
                        type="button">
                    @Language.Close
                </button>
                <button class="btn btn-primary px-3 py-2 transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                        type="button" id="export-monthly">
                    <span class="material-symbols-outlined fs-6">print</span> @Language.ExportExcel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Detail Entry Modal (Form View) -->
<div aria-hidden="true" class="modal" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-2xl overflow-hidden" style="border-radius: 12px">
            <div class="modal-header px-4 py-3 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="fw-bold mb-0">@Language.Details</h5>
                    <div class="badge rounded-pill px-3 py-1 font-semibold" style="
                                    font-size: 12px;
                                    color: rgb(51 65 85);
                                    background-color: rgb(226 232 240 / 1);
                                ">
                        @Language.Line:
                        <span id="detailLine">--</span>
                    </div>
                    <div class="badge rounded-pill px-3 py-1 font-semibold" style="
                                    font-size: 12px;
                                    color: rgb(51 65 85);
                                    background-color: rgb(226 232 240 / 1);
                                ">
                        @Language.Date:
                        <span id="detailDate">--</span>
                    </div>
                    <div class="badge rounded-pill px-3 py-1 font-semibold" style="
                                    font-size: 12px;
                                    color: rgb(51 65 85);
                                    background-color: rgb(226 232 240 / 1);
                                ">
                        @Language.Shift:
                        <span id="detailShift">--</span>
                    </div>
                    <div class="badge rounded-pill px-3 py-1 font-semibold" style="
                                    font-size: 12px;
                                    color: rgb(51 65 85);
                                    background-color: rgb(226 232 240 / 1);
                                ">
                        Fixture: <span id="detailFixtureId">--</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @*<div class="btn-group border rounded" role="group">
                            <input autocomplete="off" checked="" class="btn-check" id="roleUploader" name="roleToggle"
                                   type="radio" />
                            <label class="btn btn-sm btn-outline-primary btn-role-toggle px-3"
                                   for="roleUploader">Uploader Mode</label>
                            <input autocomplete="off" class="btn-check" id="roleApprover" name="roleToggle"
                                   type="radio" />
                            <label class="btn btn-sm btn-outline-primary btn-role-toggle px-3"
                                   for="roleApprover">Approver Mode</label>
                        </div>*@
                    <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="detail-form-table">
                        <thead>
                            <tr>
                                <th style="width: 40px">@Language.NoNumber</th>
                                <th style="width: 220px">
                                    @Language.MaintenanceItem
                                </th>
                                <th style="width: 220px">
                                    @Language.ConfirmationMethodAndStandard
                                </th>
                                <th style="width: 200px">@Language.MaintenanceImage</th>
                                <th style="width: 140px">@Language.UploaderResult</th>
                                <th style="width: 100px">@Language.UploaderID</th>
                                <th class="approver-only-col" style="width: 100px">@Language.ApproverResult</th>
                                <th class="approver-only-col" style="width: 100px">@Language.ApproverID</th>
                                <th class="approver-only-col">@Language.Remark</th>
                            </tr>
                        </thead>
                        <tbody id="detail-form-body">
                            <!-- Rows Injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button class="btn btn-link px-3 py-2 text-decoration-none fw-semibold transition-all shadow-sm"
                        data-bs-dismiss="modal">
                    @Language.Close
                </button>
                <div id="uploaderActions" class="d-flex align-items-center gap-2">
                    <button type="button"
                            class="btn btn-primary px-3 py-2 d-none transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                            id="saveUploader">
                        <span class="material-symbols-outlined fs-6">save</span> @Language.Save
                    </button>
                    <button class="btn btn-warning px-3 py-2 d-none transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                            id="editUploader">
                        <span class="material-symbols-outlined fs-6">edit</span> @Language.Edit
                    </button>
                    <button class="btn btn-danger px-3 py-2 d-none transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                            id="cancelUploader">
                        <span class="material-symbols-outlined fs-6">cancel</span> @Language.Cancel
                    </button>
                </div>
                <div class="d-none" id="approverActions">
                    <button class="btn btn-success px-3 py-2 transition-all shadow-sm d-flex align-items-center gap-2 d-none"
                            id="approveAll">
                        <span class="material-symbols-outlined fs-6">check_circle</span>
                        @Language.Approve
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/libs/lenis/lenis.min.js")"></script>
    <script src="@Url.Content("~/Scripts/libs/fancybox/fancybox.umd.js")"></script>
    <script src="@Url.Content("~/Scripts/libs/highcharts/highcharts.js")"></script>
    <script src="@Url.Content("~/Scripts/libs/highcharts/accessibility.js")"></script>

    <script>

        const i18n = @Html.Raw(Json.Encode(new {
                    allType = Language.AllType,
                    allLine = Language.AllLine,
                    allDepartment = Language.AllDepartment,
                    addFeedback = Language.AddFeedback,
                    viewImageBeforEvaluation = Language.ViewImageBeforeEvaluation,
                    unableToRetrieveDailyReport = Language.UnableToRetrieveDailyReport,
                    savingData = Language.SavingData,
                    savedSuccessfully = Language.SavedSuccessfully,
                    failedToSaveData = Language.FailedToSaveData,
                    processingImage = Language.ProcessingImage,
                    imageProcessedCompleted = Language.ImageProcessedCompleted,
                    failedToProcessImage = Language.FailedToProcessImage,
                    dailyMaintenanceList = Language.DailyMaintenanceList,
                    line = Language.Line,
                    shift = Language.Shift,
                    year = Language.Year,
                    month = Language.Month,
                    deviceName = Language.DeviceName,
                    deviceModel = Language.DeviceModel,
                    deviceNumber = Language.DeviceNumber,
                    noNumber = Language.NoNumber,
                    action = Language.Action,
                    confirmationMethodAndStandard = Language.ConfirmationMethodAndStandard,
                    date = Language.Date,
                    loadingData = Language.LoadingData,
                    noDataAvailable = Language.NoDataAvailable,
                    of = Language.Of,
                    showing = Language.Showing,
                    filtered = Language.Filtered,
                    awaitingUploadImage = Language.AwaitingUploadImage,
                    imageSizeExceed = Language.ImageSizeExceed,
                    currentSize = Language.CurrentSize,
                    statusAll = Language.StatusAll,
                    statusNoMaintenance = Language.StatusNoMaintenance,
                    statusOngoing  = Language.StatusOngoing,
                    statusDone = Language.StatusDone,
                    statusNG = Language.StatusNG,
                    statusPendingApproval = Language.StatusPendingApproval,
                    statusPendingUpload = Language.StatusPendingUpload,
                    total = Language.Total,
                    totalMaintenance = Language.TotalMaintenance,
                    noMaintenance = Language.NoMaintenance,
                    maintenanceOngoing = Language.MaintenanceOngoing,
                    maintenanceDone = Language.MaintenanceDone,
                    machineMaintenanceRate = Language.MachineMaintenanceRate,
                }));


        //// Initialize Lenis
        //const lenis = new Lenis({
        //    prevent: (node) => {
        //        return (
        //            node.closest("#maintenanceModal") ||
        //            node.closest("#detailModal") ||
        //            node.closest(".sidebar")
        //        );
        //    },
        //});

        //function raf(time) {
        //    lenis.raf(time);
        //    requestAnimationFrame(raf);
        //}

        //requestAnimationFrame(raf);

        /**
        * Global State
        */

        const DATASET = { type: "", line: "", department: "" };
        let FIXTURE_DATASET = [];
        const IMAGE_CHECK = {};
        const PREVIEW_IMAGE = {};
        //const STATUS_ALL = "All";
        //const STATUS_NO_CHECKING = "No Maintenance";
        //const STATUS_ON_GOING = "Ongoing";
        //const STATUS_DONE = "Done";
        //const STATUS_NG = "NG";
        //const STATUS_PENDING_APPROVAL = "Pending Approval";
        //const STATUS_PENDING_UPLOAD = "Pending Upload";

        const STATUS_ALL = i18n.statusAll;
        const STATUS_NO_CHECKING = i18n.statusNoMaintenance;
        const STATUS_ON_GOING = i18n.statusOngoing;
        const STATUS_DONE = i18n.statusDone;
        const STATUS_NG = i18n.statusNG;
        const STATUS_PENDING_APPROVAL = i18n.statusPendingApproval;
        const STATUS_PENDING_UPLOAD = i18n.statusPendingUpload;
        const IMAGE_SIZE = 500; //KB

        let idDashboardTimeout;
        let timer = 5 * 60 * 1000;

        let currentPage = 1;
        let pageSize = 54;

        let currentStatusFilter = i18n.statusAll; // "All";
        let maintenanceModalInstance = null;
        let detailModalInstance = null;
        let activeFixture = null;
        let activeFixtureObject = null;
        let activeMonthlyData = null;
        let activeMonthlyMonth = "";
        let activeDailyData = null;
        let activeDetailDay = null;
        let activeDetailDate = null;
        let activeMaintenanceItems = [];
        let uploadedFiles = {};
        let isApproved;
        let startEdit = false;

        const currentRole = "@HttpUtility.JavaScriptStringEncode(currentRoleFromSession)";
        const CURRENT_USER_ID = "@HttpUtility.JavaScriptStringEncode(currentUserIdFromSession)";
        const CURRENT_USER_NAME = "@HttpUtility.JavaScriptStringEncode(currentUserNameFromSession)";
        const CURRENT_SESSION_ROLE = "@HttpUtility.JavaScriptStringEncode(roleFromSession)";
        const CAN_APPROVE = CURRENT_SESSION_ROLE.toLowerCase() === "admin";
        const DEFAULT_UPLOAD_ID = CURRENT_USER_ID;
        const DEFAULT_APPROVAL_ID = CURRENT_USER_ID;

        /**
        * Utility: Get Status Styling
        */
        const getStatusStyle = (status) => {
            switch (normalizeStatus(status)) {
                case STATUS_NO_CHECKING:
                case STATUS_NG:
                    return { class: "bg-danger-subtle text-danger", dot: "bg-danger" };
                case STATUS_PENDING_APPROVAL:
                    return { class: "bg-primary-subtle-custom text-primary-custom", dot: "bg-warning" };
                case STATUS_PENDING_UPLOAD:
                    return { class: "bg-warning-subtle text-warning", dot: "bg-warning" };
                case STATUS_DONE:
                default:
                    return { class: "bg-success-subtle text-success", dot: "bg-success" };
            }
        };

        const getStatusText = (status) => {
            switch (normalizeStatus(status)) {
                case STATUS_NO_CHECKING:
                case STATUS_NG:
                    return { class: "bg-danger-subtle text-danger", dot: "bg-danger" };
                case STATUS_PENDING_APPROVAL:
                    return { class: "bg-primary-subtle-custom text-primary-custom", dot: "bg-warning" };
                case STATUS_PENDING_UPLOAD:
                    return { class: "bg-warning-subtle text-warning", dot: "bg-warning" };
                case STATUS_DONE:
                default:
                    return { class: "bg-success-subtle text-success", dot: "bg-success" };
            }
        };

        const normalizeStatus = (status) => {
            const value = (status ?? "").toString().trim();
            const compact = value.toLowerCase().replace(/\s+/g, "");

            //if (compact === "ongoing" || compact === "on-going") return STATUS_ON_GOING;
            if (compact === "pendingapproval") return STATUS_PENDING_APPROVAL;
            else if (compact === "pendingupload") return STATUS_PENDING_UPLOAD;
            else if (compact === "ongoing" || compact === "on-going") return STATUS_ON_GOING;
            else if (compact === "nochecking" || compact === 'nomaintenance') return STATUS_NO_CHECKING;
            else if (compact === "done") return STATUS_DONE;
            else if (compact === "ng") return STATUS_NG;

            return value || STATUS_NO_CHECKING;
        };

        const normalizeFixture = (item) => {
            return {
                numberOrder: getProp(item, "number_Order", "Number_Order", "numberOrder", "NumberOrder"),
                fixture: getProp(item, "eQ_SN", "EQ_SN", "eq_SN", "eqSn", "Fixture", "fixture"),
                eqName: getProp(item, "eQ_Name", "EQ_Name", "eq_Name", "eqName"),
                eqModel: getProp(item, "eQ_Model", "EQ_Model", "eq_Model", "eqModel"),
                line: getProp(item, "line", "Line"),
                status: normalizeStatus(getProp(item, "status", "Status"))
            };
        };

        const getCurrentMonthValue = () => {
            const now = new Date();
            return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
        };

        const toMonthInputValue = (year, month) => {
            const y = parseInt(year);
            const m = parseInt(month);

            if (!y || !m) return "";

            return `${y}-${String(m).padStart(2, "0")}`;
        };

        const getMonthlyInputValue = () => {
            const input = document.getElementById("monthlyReportMonth");
            return input ? input.value : "";
        };

        const setMonthlyLoading = () => {
            document.getElementById("maintenance-body").innerHTML =
                `<tr><td colspan="34" class="text-center py-4 text-muted">${i18n.loadingData}...</td></tr>`;
        };

        const bindMonthlyHeader = (fixture) => {
            const reportYear = getProp(activeMonthlyData, "year", "Year") || "";
            const reportMonth = getProp(activeMonthlyData, "month", "Month") || "";

            document.getElementById("maintenanceModalLabel").textContent =
                getProp(activeMonthlyData, "eQ_Name", "EQ_Name") || fixture.eqName || "Machine";
