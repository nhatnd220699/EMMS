                    <button class="btn btn-warning px-3 py-2 d-none transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                            id="editUploader">
                        <span class="material-symbols-outlined fs-6">edit</span> Edit
                    </button>
                    <button class="btn btn-danger px-3 py-2 d-none transition-all shadow-sm fw-semibold d-flex align-items-center gap-2"
                            id="cancelUploader">
                        <span class="material-symbols-outlined fs-6">cancel</span> Cancel
                    </button>
                </div>
                <div class="d-none" id="approverActions">
                    <button class="btn btn-success px-3 py-2 transition-all shadow-sm d-flex align-items-center gap-2 d-none"
                            id="approveAll">
                        <span class="material-symbols-outlined fs-6">check_circle</span>
                        Approve
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/libs/lenis/lenis.min.js"></script>
    <script src="~/Scripts/libs/fancybox/fancybox.umd.js"></script>
    <script src="~/Scripts/libs/dayjs/dayjs.min.js"></script>
    <script defer src="~/Scripts/libs/xlsx/xlsx.full.min.js"></script>

    <script src="~/Scripts/services/fixture-service.js"></script>

    <script>
        // Initialize Lenis
        const lenis = new Lenis({
            prevent: (node) => {
                return (
                    node.closest("#maintenanceModal") ||
                    node.closest("#detailModal") ||
                    node.closest(".sidebar")
                );
            },
        });

        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);


        const DATASET = { type: "", line: "", department: "" };
        let FIXTURE_DATASET = [];
        const IMAGE_CHECK = {};
        const PREVIEW_IMAGE = {};
        const PREVIEWED_IMAGE = {};
        const STATUS_ALL = "All";
        const STATUS_NO_CHECKING = "No checking";
        const STATUS_ON_GOING = "Ongoing";
        const STATUS_DONE = "Done";
        const STATUS_NG = "NG";

        /**
        * Global State
        */
        let currentPage = 1;
        let pageSize = 24;
        let currentStatusFilter = "All";

        let maintenanceModalInstance = null;
        let detailModalInstance = null;
        let activeFixture = null;
        let activeFixtureObject = null;
        let activeMonthlyData = null;
        let activeMonthlyMonth = "";
        let activeDailyData = null;
        let activeDetailDay = null;
        let activeDetailDate = null;
        let activeMaintenanceItems = [];
        let currentRole = "@HttpUtility.JavaScriptStringEncode(currentRoleFromSession)";
        let uploadedFiles = {};
        const CURRENT_USER_ID = "@HttpUtility.JavaScriptStringEncode(currentUserIdFromSession)";
        const CURRENT_USER_NAME = "@HttpUtility.JavaScriptStringEncode(currentUserNameFromSession)";
        const CURRENT_SESSION_ROLE = "@HttpUtility.JavaScriptStringEncode(roleFromSession)";
        const CAN_APPROVE = CURRENT_SESSION_ROLE.toLowerCase() === "admin";
        const DEFAULT_UPLOAD_ID = CURRENT_USER_ID || "V5070000";
        const DEFAULT_APPROVAL_ID = CURRENT_USER_ID || "V4070216";



        let isApproved;

        let startEdit = false;

        /**
        * Utility: Get Status Styling
        */
        const getStatusStyle = (status) => {
            switch (normalizeStatus(status)) {
                case STATUS_NO_CHECKING:
                case STATUS_NG:
                    return { class: "bg-danger-subtle text-danger", dot: "bg-danger" };
                case STATUS_ON_GOING:
                    return { class: "bg-warning-subtle text-warning", dot: "bg-warning" };
                case STATUS_DONE:
                default:
                    return { class: "bg-success-subtle text-success", dot: "bg-success" };
            }
        };

        const getProp = (obj, ...keys) => {
            if (!obj) return null;

            for (const key of keys) {
                if (Object.prototype.hasOwnProperty.call(obj, key)) {
                    return obj[key];
                }
            }

            return null;
        };

        const normalizeStatus = (status) => {
            const value = (status ?? "").toString().trim();
            const compact = value.toLowerCase().replace(/\s+/g, "");

            if (compact === "ongoing" || compact === "on-going") return STATUS_ON_GOING;
            if (compact === "nochecking") return STATUS_NO_CHECKING;
            if (compact === "done") return STATUS_DONE;
            if (compact === "ng") return "NG";

            return value || STATUS_NO_CHECKING;
        };

        const normalizeFixture = (item) => {
            return {
                numberOrder: getProp(item, "number_Order", "Number_Order", "numberOrder", "NumberOrder"),
                fixture: getProp(item, "eQ_SN", "EQ_SN", "eq_SN", "eqSn", "Fixture", "fixture"),
                eqName: getProp(item, "eQ_Name", "EQ_Name", "eq_Name", "eqName"),
                eqModel: getProp(item, "eQ_Model", "EQ_Model", "eq_Model", "eqModel"),
                line: getProp(item, "line", "Line"),
                status: normalizeStatus(getProp(item, "status", "Status"))
            };
        };

        const getResponseData = (response) => {
            return getProp(response, "data", "Data");
        };

        const isSuccessResponse = (response) => {
            return getProp(response, "success", "Success") === true;
        };

        const getResponseMessage = (response) => {
            return getProp(response, "message", "Message") || "Request failed.";
        };

        const fetchJson = async (url) => {
            const response = await fetch(url, { method: "GET" });

             if (response.status === 401) {
                 window.location.href = '@Url.Action("Index", "Login")';
                 return null;
             }

            const text = await response.text();
            let data = null;

            try {
                data = text ? JSON.parse(text) : null;
            } catch (error) {
                throw new Error(text || `HTTP ${response.status}`);
            }

            if (!response.ok || !isSuccessResponse(data)) {
                throw new Error(getResponseMessage(data));
            }

            return getResponseData(data);
        };

        const buildQuery = (params) => {
            const query = new URLSearchParams();

            Object.keys(params).forEach((key) => {
                const value = params[key];
                if (value !== undefined && value !== null && value !== "") {
                    query.append(key, value);
                }
            });

            return query.toString();
        };

        const getCurrentMonthValue = () => {
            const now = new Date();
            return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`;
        };

        const toMonthInputValue = (year, month) => {
            const y = parseInt(year);
            const m = parseInt(month);

            if (!y || !m) return "";

            return `${y}-${String(m).padStart(2, "0")}`;
        };

        const getMonthlyInputValue = () => {
            const input = document.getElementById("monthlyReportMonth");
            return input ? input.value : "";
        };

        const setMonthlyLoading = () => {
            document.getElementById("maintenance-body").innerHTML =
                '<tr><td colspan="34" class="text-center py-4 text-muted">Loading monthly...</td></tr>';
        };

        const bindMonthlyHeader = (fixture) => {
            const reportYear = getProp(activeMonthlyData, "year", "Year") || "";
            const reportMonth = getProp(activeMonthlyData, "month", "Month") || "";

            document.getElementById("maintenanceModalLabel").textContent =
                getProp(activeMonthlyData, "eQ_Name", "EQ_Name") || fixture.eqName || "Machine";
            document.getElementById("modalLine").textContent =
                getProp(activeMonthlyData, "line", "Line") || fixture.line || "";
            document.getElementById("modalShift").textContent =
                getProp(activeMonthlyData, "shift", "Shift") || "";
            document.getElementById("modalYear").textContent = reportYear;
            document.getElementById("modalMonth").textContent = reportMonth;
            document.getElementById("modalDeviceName").textContent =
                getProp(activeMonthlyData, "eQ_Name", "EQ_Name") || "";
            document.getElementById("modalDeviceMod").textContent =
                getProp(activeMonthlyData, "eQ_Model", "EQ_Model") || "";
            document.getElementById("modalDeviceNo").textContent =
                getProp(activeMonthlyData, "eQ_SN", "EQ_SN") || fixture.fixture || "";

            const monthValue = toMonthInputValue(reportYear, reportMonth);
            if (monthValue) {
                const input = document.getElementById("monthlyReportMonth");
                if (input) input.value = monthValue;
                activeMonthlyMonth = monthValue;
            }
        };

        const normalizeDateText = (value) => {
            if (!value) return "";

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return value.toString().substring(0, 10);

            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
        };

        const setLoadingGrid = (message) => {
            document.getElementById("fixture-grid").innerHTML =
                `<div class="col-12 text-center py-5"><p class="text-muted">${message}</p></div>`;
        };

        const fillSelect = (selectId, data, defaultText) => {
            const select = document.getElementById(selectId);
            const currentValue = select.value;

            select.innerHTML = `<option value="">${defaultText}</option>`;
            (data || []).forEach((value) => {
                const option = document.createElement("option");
                option.value = value;
                option.textContent = value;
                select.appendChild(option);
            });

            select.value = [...select.options].some((x) => x.value === currentValue) ? currentValue : "";
        };

        const loadFilterOptions = async () => {
            try {
                const result = await ApiClient.get('api/fixture/options');
                const options = getResponseData(result);

                fillSelect("type", getProp(options, "types", "Types"), "All type");
                fillSelect("line", getProp(options, "lines", "Lines"), "All line");
                fillSelect("department", getProp(options, "departments", "Departments"), "All dept");
            } catch (error) {
                alert(error.message);
            }
        };

        /**
        * KPI Updates
        */
        const updateKPIs = async () => {
            const counts = FIXTURE_DATASET.reduce((acc, curr) => {
                acc[curr.status] = (acc[curr.status] || 0) + 1;
                return acc;
            }, {});

            document.getElementById("kpi-total").textContent = FIXTURE_DATASET.length.toLocaleString();
            document.getElementById("kpi-maintenance").textContent = counts[STATUS_NO_CHECKING] || 0;
            document.getElementById("kpi-waiting").textContent = counts[STATUS_ON_GOING] || 0;
            document.getElementById("kpi-completed").textContent = counts[STATUS_DONE] || 0;
        };

        /**
            * Unified Rendering Logic (Handles Filtering, Pagination, and Display)
            */
        const updateDisplay = async (resetPagination = false) => {

            if (resetPagination) currentPage = 1;

            const grid = document.getElementById("fixture-grid");
