            activeMonthlyMonth = getMonthlyInputValue() || getCurrentMonthValue();
            setMonthlyLoading();
            await refreshMonthlyModal(true);
        };

        const collectDailyData = () => {

            const rows = document.querySelectorAll("#detail-form-body tr");
            const result = [];

            rows.forEach((tr, idx) => {
                const mtNo = tr.dataset.mtNo;
                const numberOrder = tr.dataset.numberOrder;
                // basic fields
                const mtItem = tr.querySelector(`td.mt-item`)?.text || "";
                const mtDesc = tr.querySelector(`td.mt-desc`)?.text || "";
                const uploadResult = tr.querySelector(`input[name="uploader_res_${mtNo}"]:checked`)?.value || "NA";
                const approvalResult = tr.querySelector(`input[name="approver_res_${mtNo}"]:checked`)?.value || "";
                const remark = tr.querySelector("textarea")?.value || "";
                const uploadId = tr.querySelector(".upload-id-cell")?.innerText || "";
                const approvalId = tr.querySelector(".approval-id-cell")?.innerText || "";

                // lấy gallery
                const galleryItems = tr.querySelectorAll(`#gallery_${mtNo} .gallery-item`);

                const existingImagePaths = [];
                const newFiles = [];

                galleryItems.forEach(item => {
                    // ảnh mới
                    if (item._file) {
                        newFiles.push(item._file);
                    }

                    // ảnh cũ
                    if (item.dataset.path) {
                        existingImagePaths.push(item.dataset.path);
                    }
                });

                result.push({
                    numberOrder,
                    mtNo,
                    mtItem,
                    mtDesc,
                    uploadResult,
                    approvalResult,
                    remark,
                    uploadId,
                    approvalId,
                    existingImagePaths,
                    newFiles
                });
            });

            //console.log(result);

            return result;
        };


        const sumbitDailyForm = async (action) => {

            const saveUploader = document.querySelector("#saveUploader");
            saveUploader.disabled = true;

            if (!ActionLock.acquire('save-daily')) return;


            const data = collectDailyData() || [];

            if (data.length <= 0) {
                Popup.show(i18n.unableToRetrieveDailyReport);
                return;
            }

            //const isApproverAllResult = data.every(item => item.approvalResult);

            //if (currentRole === 'approver' && !isApproverAllResult) {
            //    alert("Please complete the evaluation of all items before submitting the data!");
            //    return;
            //}

            Popup.show(`${i18n.savingData}...`);

            const formData = new FormData();

            const type = DATASET.type || "FATP";
            const line = getProp(activeDailyData, "line", "Line") || DATASET.line || ""
            const department = DATASET.department || ""
            const eqSn = getProp(activeDailyData, "eQ_SN", "EQ_SN") || activeFixture || ""
            const eqName = getProp(activeDailyData, "eQ_Name", "EQ_Name") || ""
            const eqModel = getProp(activeDailyData, "eQ_Model", "EQ_Model") || ""
            const date = activeDetailDate || normalizeDateText(getProp(activeDailyData, "date", "Date"))
            const shift = getProp(activeDailyData, "shift", "Shift") || "Day"
            const isApproverMode = currentRole === "approver" ? true : false;

            formData.append("Type", type);
            formData.append("Line", line);
            formData.append("Department", department);
            formData.append("EQ_SN", eqSn);
            formData.append("EQ_Name", eqName);
            formData.append("EQ_Model", eqModel);
            formData.append("Date", date);
            formData.append("Shift", shift);
            formData.append("IsApproverMode", isApproverMode);
            formData.append("Action", action);

            data.forEach((item, i) => {

                formData.append(`CheckItems[${i}].MT_No`, item.mtNo);
                formData.append(`CheckItems[${i}].Number_Order`, item.numberOrder);
                formData.append(`CheckItems[${i}].MT_Item`, item.mtItem);
                formData.append(`CheckItems[${i}].MT_Desc`, item.mtDesc);

                formData.append(`CheckItems[${i}].Upload_Result`, item.uploadResult);
                formData.append(`CheckItems[${i}].Approval_Result`, item.approvalResult);
                formData.append(`CheckItems[${i}].Remark`, item.remark);
                formData.append(`CheckItems[${i}].Upload_ID`, CURRENT_USER_ID);
                formData.append(`CheckItems[${i}].Approval_ID`, CURRENT_USER_ID);

                // ảnh cũ (string path)
                item.existingImagePaths.forEach((path, j) => {
                    formData.append(`CheckItems[${i}].ExistingImagePaths[${j}]`, path);
                });

                // ảnh mới (file)
                item.newFiles.forEach((file, j) => {
                    formData.append(`CheckItems[${i}].NewFiles[${j}]`, file);
                });
            });

            try {

                const result = await ApiClient.postForm('api/fixture/daily/submit', formData);

                if (result.Success === true) {
                    Popup.success(i18n.savedSuccessfully)
                    startEdit = false; // khi lưu xong thì trạng thái edit phải được reset
                    openMaintenanceModal(activeFixtureObject);
                    updateDisplay();
                } else {
                    Popup.error(i18n.failedToSaveData);
                }

            } catch (err) {

                Popup.error(err.message, 2000);
            } finally {
                ActionLock.release('save-daily');
                saveUploader.removeAttribute('disabled');
            }

        }

