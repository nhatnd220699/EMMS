        function initFancybox() {

            Fancybox.bind("[data-fancybox]", {
                closeButton: false,
                dragToClose: false,
                backdropClick: false,
                Keyboard: {
                    Escape: true
                },
                loop: true,
                Carousel: {
                    Thumbs: {
                        type: "scrollable",
                    },
                    Toolbar: {
                        display: {
                            left: ["counter"],
                            middle: [
                                "zoomIn",
                                "zoomOut",
                                "toggle1to1",
                                "rotateCCW",
                                "rotateCW",
                                "flipX",
                                "flipY",
                                "reset",
                            ],
                            right: ["autoplay", "thumbs", "close"],
                        },
                    },
                },
                on: {
                    ready: (fancybox) => {
                        var mtno = Fancybox.getInstance().getSlide().mtno;

                        fancybox.currentMtno = mtno;

                        if (currentRole?.toLocaleLowerCase() === 'approver' && !PREVIEW_IMAGE[mtno]) {

                            fancybox.LOCK_DURATION = 5;
                            fancybox.isClosable = false;
                            const closeBtn = document.querySelector("[data-fancybox-close]");

                            if (closeBtn) {
                                closeBtn.style.display = "none";
                            }

                            let remaining = fancybox.LOCK_DURATION;

                            fancybox.closeTimer = setTimeout(() => {
                                fancybox.isClosable = true;

                                if (closeBtn) {
                                    closeBtn.style.display = "";
                                    PREVIEW_IMAGE[mtno] = true;
                                }

                            }, fancybox.LOCK_DURATION * 1000);
                        }
                    },
                    keydown: (fancybox, event) => {
                        if (event.key === "Escape" && !fancybox.isClosable) {
                            event.preventDefault();
                            event.stopPropagation();

                            return false;
                        }
                    },
                    shouldClose: (fancybox, event) => {
                        return fancybox.isClosable;
                    },
                    destroy: (fancybox) => {
                        clearTimeout(fancybox.closeTimer);
                    },
                }
            });
        }

