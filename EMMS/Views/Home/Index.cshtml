                <th colspan="${days + 3}">日保養記錄 / <br>Daily Maintenance List / Ghi lại bảo trì hàng ngày</th>
            `;
            thead.appendChild(row1);

            const row2 = document.createElement("tr");
            row2.innerHTML = `
                <th colspan="2" class="text-start">線別 / Line: ${line}</th>
                <th colspan="1" class="text-start">班別 / Shift: ${shift}</th>
                <th colspan="20" class="text-start">年 / Year: ${year}</th>
                <th colspan="${days - 20}" class="text-start">月 / Month: ${month}</th>
            `;
            thead.appendChild(row2);

            const row3 = document.createElement("tr");
            row3.innerHTML = `
                <th colspan="3" class="text-start">設備名稱 / Device Name: ${deviceName}</th>
                <th colspan="16" class="text-start">設備型號 / Device Mod: ${deviceModel}</th>
                <th colspan="${days - 16}" class="text-start">設備編號 / Device Number: ${deviceNumber}</th>
            `;
            thead.appendChild(row3);

            const row4 = document.createElement("tr");
            row4.innerHTML = `
                <th rowspan="2" style="width: 40px">序號 / No.</th>
                <th rowspan="2" style="width: 220px">執行動作 / Action / Thao tác</th>
                <th rowspan="2" style="width: 220px">確認方法及標準 / Confirmation Method &amp; Standard/Phương pháp và tiêu chuẩn xác định</th>
