                card.addEventListener("click", () => {
                    // UI Toggle
                    document
                        .querySelectorAll(".kpi-card")
                        .forEach((c) => c.classList.remove("active-filter"));
                    card.classList.add("active-filter");

                    // Filter logic
                    currentStatusFilter = card.getAttribute("data-status");
                    updateDisplay(true);
                });
            });

            // Micro-interactions for buttons
            document.addEventListener("mousedown", (e) => {
                const interactive = e.target.closest(
                    ".sidebar-item, .submenu-item, .fixture-card, .btn, .page-link",
                );
                if (
                    interactive &&
                    !interactive.classList.contains("custom-collapse-toggle") &&
                    !interactive.classList.contains("disabled-link")
                ) {
                    interactive.style.transform = "scale(0.975)";
                    interactive.style.transition = "transform 0.1s ease";
                }
            });
            document.addEventListener("mouseup", (e) => {
                const interactive = e.target.closest(
                    ".sidebar-item, .submenu-item, .fixture-card, .btn, .page-link",
                );
                if (interactive) interactive.style.transform = "";
            });

            // Role Toggling
            document.getElementById("roleUploader").addEventListener("change", (e) => {
                if (e.target.checked) {
                    currentRole = "uploader";
                    document.getElementById("uploaderActions").classList.remove("d-none");
                    document.getElementById("approverActions").classList.add("d-none");
                    //toggleDetailColumns();
                    renderDetailRows();
                }
            });

            document.getElementById("roleApprover").addEventListener("change", (e) => {
                if (e.target.checked) {
                    currentRole = "approver";
                    document.getElementById("uploaderActions").classList.add("d-none");
                    document.getElementById("approverActions").classList.remove("d-none");
                    //toggleDetailColumns();
                    renderDetailRows();
                }
            });

            document.getElementById("saveUploader").addEventListener("click", async () => {
                await saveDailyForm(false);
            });

            document.getElementById("approveAll").addEventListener("click", async () => {
                await saveDailyForm(true);
            });

            document.getElementById("type").addEventListener("change", (e) => {
                DATASET["type"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById("line").addEventListener("change", (e) => {
                DATASET["line"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById("department").addEventListener("change", (e) => {
                DATASET["department"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById('fixture-sn').addEventListener("input", (e) => {
                DATASET["fixtureSNInput"] = (e.target.value ?? "")?.trim();
            });

            document.getElementById('fixture-sn').addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    DATASET["fixtureSNInput"] = (e.target.value ?? "").trim();
                    updateDisplay(true);
                }
            });

            document.getElementById("detailModal").addEventListener("hidden.bs.modal", () => {
                if (maintenanceModalInstance) {
                    maintenanceModalInstance.show();
                }

                //Cleanup temp blob image
                document.querySelectorAll(".gallery-item").forEach((el) => {
                    if (el._url) {
                        URL.revokeObjectURL(el._url);
                    }
                });
            });


            // Tạo countdown
            const countdown = document.createElement("div");
            countdown.className = "fb-countdown";

            Fancybox.bind("[data-fancybox]", {
                closeButton: false,
                dragToClose: false,
                Backdrop: {
                    closeOnClick: false
                },
                Keyboard: {
                    Escape: true
                },
                loop: true,
                Carousel: {
                    Thumbs: {
                        type: "scrollable",
                    },
                    Toolbar: {
                        display: {
                            left: ["counter"],
                            middle: [
                                "zoomIn",
                                "zoomOut",
                                "toggle1to1",
                                "rotateCCW",
                                "rotateCW",
                                "flipX",
                                "flipY",
                                "reset",
                            ],
                            right: ["autoplay", "thumbs", "close"],
                        },
                    },


                },
                on: {
                    ready: (fancybox) => {
                        fancybox.LOCK_DURATION = 5;
                        fancybox.isClosable = false;
                        const closeBtn = document.querySelector("[data-fancybox-close]");

                        if (closeBtn) {
                            closeBtn.style.display = "none";
                        }

                        document.body.appendChild(countdown);

                        let remaining = fancybox.LOCK_DURATION;

                        countdown.innerHTML = `
                                    Vui lòng xem ảnh ${remaining}s
                                `;

                        // cập nhật mỗi giây
                        fancybox.countdownInterval = setInterval(() => {
                            remaining--;

                            if (remaining > 0) {
                                countdown.innerHTML = `Vui lòng xem ảnh ${remaining}s`;
                            } else {
                                countdown.innerHTML = `Bạn có thể đóng preview`;
                                clearInterval(fancybox.countdownInterval);
                            }
                        }, 1000);


                        fancybox.closeTimer = setTimeout(() => {
                            fancybox.isClosable = true;

                            if (closeBtn) {
                                closeBtn.style.display = "";
                            }

                        }, fancybox.LOCK_DURATION * 1000);
                    },
                    keydown: (fancybox, event) => {
                        if (event.key === "Escape" && !fancybox.isClosable) {
                            event.preventDefault();
                            event.stopPropagation();

                            return false;
                        }
                    },
                    shouldClose: (fancybox, event) => {
                        return fancybox.isClosable;
                    },
                    destroy: (fancybox) => {
                        clearTimeout(fancybox.closeTimer);
                        document.querySelector('.fb-countdown').remove();
                    },
                }
            });
        });
    </script>
}

