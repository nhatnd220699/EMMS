        //    const table = document.getElementById("maintenance-table");
        //    const workbook = XLSX.utils.table_to_book(table);
        //    XLSX.writeFile(workbook, "data_monthly.xlsx");
        //}

        function initFancybox() {

            Fancybox.bind("[data-fancybox]", {
                closeButton: false,
                dragToClose: false,
                backdropClick: false,
                Keyboard: {
                    Escape: true
                },
                loop: true,
                Carousel: {
                    Thumbs: {
                        type: "scrollable",
                    },
                    Toolbar: {
                        display: {
                            left: ["counter"],
                            middle: [
                                "zoomIn",
                                "zoomOut",
                                "toggle1to1",
                                "rotateCCW",
                                "rotateCW",
                                "flipX",
                                "flipY",
                                "reset",
                            ],
                            right: ["autoplay", "thumbs", "close"],
                        },
                    },
                },
                on: {
                    ready: (fancybox) => {
                        var mtno = Fancybox.getInstance().getSlide().mtno;

                        fancybox.currentMtno = mtno;

                        if (currentRole?.toLocaleLowerCase() === 'approver' && !PREVIEW_IMAGE[mtno] && checkToday(activeDetailDate)) {

                            fancybox.LOCK_DURATION = 5;
                            fancybox.isClosable = false;
                            const closeBtn = document.querySelector("[data-fancybox-close]");

                            if (closeBtn) {
                                closeBtn.style.display = "none";
                            }

                            let remaining = fancybox.LOCK_DURATION;

                            fancybox.closeTimer = setTimeout(() => {
                                fancybox.isClosable = true;

                                if (closeBtn) {
                                    closeBtn.style.display = "";
                                    PREVIEW_IMAGE[mtno] = true;
                                }

                            }, fancybox.LOCK_DURATION * 1000);
                        }
                    },
                    keydown: (fancybox, event) => {
                        if (event.key === "Escape" && !fancybox.isClosable) {
                            event.preventDefault();
                            event.stopPropagation();

                            return false;
                        }
                    },
                    shouldClose: (fancybox, event) => {
                        return fancybox.isClosable;
                    },
                    destroy: (fancybox) => {
                        clearTimeout(fancybox.closeTimer);
                    },
                }
            });
        }

        /**
        * Initialization
        */
        document.addEventListener("DOMContentLoaded", async () => {

            await loadFilterOptions();
            updateDisplay();
            initFancybox();

            //requestAnimationFrame(raf);

            document.getElementById("pageSizeSelector").value = pageSize;

            // Page Size Selector
            document.getElementById("pageSizeSelector").addEventListener("change", (e) => {

                pageSize = parseInt(e.target.value);
                updateDisplay(true);
            });

            // Refresh Button
            document.getElementById("refresh-btn").addEventListener("click", () => {
                updateDisplay(true);
            });

            document.getElementById("monthlyReportSearchBtn").addEventListener("click", searchMonthlyReport);

            document.getElementById("monthlyReportMonth").addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    searchMonthlyReport();
                }
            });

            // KPI Card Click Events for Unified Filtering
            document.querySelectorAll(".kpi-card").forEach((card) => {

                card.addEventListener("click", () => {
                    // UI Toggle
                    document
                        .querySelectorAll(".kpi-card")
                        .forEach((c) => c.classList.remove("active-filter"));
                    card.classList.add("active-filter");

                    // Filter logic
                    currentStatusFilter = card.getAttribute("data-status");
                    updateDisplay(true);
                });
            });

            // Micro-interactions for buttons
            document.addEventListener("mousedown", (e) => {

                const interactive = e.target.closest(
                    ".sidebar-item, .submenu-item, .fixture-card, .btn, .page-link",
                );

                if (
                    interactive &&
                    !interactive.classList.contains("custom-collapse-toggle") &&
                    !interactive.classList.contains("disabled-link")
                ) {
                    interactive.style.transform = "scale(0.975)";
                    interactive.style.transition = "transform 0.1s ease";
                }
            });

            document.addEventListener("mouseup", (e) => {

                const interactive = e.target.closest(
                    ".sidebar-item, .submenu-item, .fixture-card, .btn, .page-link",
                );
                if (interactive) interactive.style.transform = "";
            });

            document.getElementById("editUploader").addEventListener("click", function () {

                startEdit = true;
                this.classList.add('d-none');
                document.querySelector('#saveUploader').classList.remove('d-none');
                document.querySelector('#cancelUploader').classList.remove('d-none');

                renderDetailRows(true);
            });

            document.getElementById("cancelUploader").addEventListener("click", (e) => {

                startEdit = false;
                e.target.classList.add('d-none');

                renderDetailRows(false);
            });

            document.getElementById('saveUploader').addEventListener('click', function () {

                if (!startEdit) {
                    //sumbitDailyForm('Upload_Equipment_By_SN');
                    sumbitDailyForm('create');
                } else {
                    //submitDailyForm("Edit_Equipment_By_SN");
                    sumbitDailyForm('edit');
                }
            });

            document.getElementById('approveAll').addEventListener('click', function () {
                //sumbitDailyForm('Approve_Equipment_By_SN');
                sumbitDailyForm('approve');
            });

            document.getElementById("type").addEventListener("change", (e) => {

                DATASET["type"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById("line").addEventListener("change", (e) => {

                DATASET["line"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById("department").addEventListener("change", (e) => {

                DATASET["department"] = (e.target.value ?? "")?.trim();
                updateDisplay(true);
            });

            document.getElementById('fixture-sn').addEventListener("input", (e) => {
                DATASET["fixtureSNInput"] = (e.target.value ?? "")?.trim();
            });

            document.getElementById('fixture-sn').addEventListener("keydown", (e) => {

                if (e.key === "Enter") {
                    e.preventDefault();
                    DATASET["fixtureSNInput"] = (e.target.value ?? "").trim();
                    updateDisplay(true);
                }
            });

            document.getElementById("detailModal").addEventListener("hidden.bs.modal", () => {

                if (maintenanceModalInstance) {
                    maintenanceModalInstance.show();
                }

                //Cleanup temp blob image
                document.querySelectorAll(".gallery-item").forEach((el) => {
                    if (el._url) {
                        URL.revokeObjectURL(el._url);
                    }
                });
            });

            document.addEventListener('click', function (e) {

                if (e.target.matches('.approver-radio input[type="radio"]')) {

                    const mtNo = e.target.dataset.mtNo;

                    //if (isApproved) {
                    //    return;
                    //}

                    if (!PREVIEW_IMAGE[mtNo]) {
                        e.preventDefault();
                        Popup.warning('请在评估前先查看图片/Vui lòng xem ảnh trước khi đánh giá');
                    }
                }
            });

            document.querySelector('#export-monthly').addEventListener('click', function () {
                exportMonthlyTable();
            });


            document.addEventListener('keydown', function (e) {
                if (e.key === 'F11') {
                    e.preventDefault();

                    const wrapper = document.querySelector('#wrapper');

                    if (!document.fullscreenElement) {
                        wrapper.requestFullscreen();
                    } else {
                        document.exitFullscreen();
                    }
                }
            });

            document.addEventListener("fullscreenchange", () => {
                const wrapper = document.querySelector('#wrapper');
                const content = document.querySelector('main');
                const navbar = document.querySelector('nav');

                if (document.fullscreenElement === wrapper) {

                    navbar.style.display = 'none';
                    content.style.paddingTop = '0px';
                    content.style.overflowY = 'auto';

                } else {

                    navbar.style.display = '';
                    content.style.paddingTop = '80px';
                    content.style.overflowY = '';

                }
            });
        });
    </script>
