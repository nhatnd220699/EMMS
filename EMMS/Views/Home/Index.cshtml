                             <label for="approver_resNg_${mtNo}" class="radio-label-text">NG</label>
                         </div>
                         <div class="radio-inner">
                             <input type="radio" id="approver_resNa_${mtNo}" name="approver_res_${mtNo}" data-mt-no=${mtNo} value="NA" ${approvalResult === "NA" ? "checked" : ""} ${currentRole !== "approver" ? "disabled" : ""} class="hidden-radio radio-na">
                             <label for="approver_resNa_${mtNo}" class="custom-radio"></label>
                             <label for="approver_resNa_${mtNo}" class="radio-label-text">NA</label>
                         </div>
                    </div>
                `;

                // Remark Cell Logic
                let remarkHtml = `<textarea class="form-control text-xs" rows="3" placeholder="Add feedback..." ${!isToday || (currentRole === 'uploader' && isUploaded && !startEdit) ? 'disabled' : ''}>${remark}</textarea>`;

                tr.innerHTML = `
                    <td class="text-center number-order">${numberOrder}</td>
                    <td class="mt-item">${actionText}</td>
                    <td class="mt-desc">${methodText}</td>
                    <td>${imageCellHtml}</td>
                    <td>${uploaderResultHtml}</td>
                    <td class="text-center upload-id-cell">${uploadId}</td>
                    <td class="approver-only-col">${approvalResultHtml}</td>
                    <td class="text-center approver-only-col approval-id-cell">${approvalId}</td>
                    <td class="text-center approver-only-col">${remarkHtml}</td>
                `;

                body.appendChild(tr);

                // Gán giá trị result vào DOM.
                setTimeout(() => {

                    const gallery = document.getElementById(`gallery_${mtNo}`);
                    const items = gallery.querySelectorAll(".gallery-item");

                    items.forEach(item => {
                        item._result = item.dataset.result || 'NA';
                    });

                }, 0);

                // Gán event cho nút remove ảnh
                setTimeout(() => {

                    const gallery = document.getElementById(`gallery_${mtNo}`);

                    gallery.querySelectorAll(".remove-btn").forEach(btn => {

                        btn.addEventListener("click", (e) => {
                            const item = e.target.closest(".gallery-item");
                            item.remove();

                            recalcRowResult(mtNo, gallery);
                        });
                    });

                }, 0);

            });
        };


        function checkToday(dateStr) {

            const today = new Date();

            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');

            const todayStr = `${yyyy}-${mm}-${dd}`;

            return dateStr === todayStr;
        }


        const initTable = () => {

            const headerRow = document.getElementById("date-header-row");
            const body = document.getElementById("maintenance-body");

            headerRow.innerHTML = "";
            body.innerHTML = "";

            const year = parseInt(getProp(activeMonthlyData, "year", "Year")) || new Date().getFullYear();
            const month = parseInt(getProp(activeMonthlyData, "month", "Month")) || (new Date().getMonth() + 1);
            const line = getProp(activeMonthlyData, "line", "Line") || "";
            const shift = getProp(activeMonthlyData, "shift", "Shift") || "";
            const items = getProp(activeMonthlyData, "maintenanceItems", "MaintenanceItems") || [];
            const days = new Date(year, month, 0).getDate();

            for (let i = 1; i <= days; i++) {
                const day = i;
                const date = `${year}-${String(month).padStart(2, "0")}-${String(i).padStart(2, "0")}`;
                const isToday = checkToday(date);
                const th = document.createElement("th");
                th.className = `day-col font-mediumn text-decoration-underline ${isToday ? 'active' : ''}`;
                th.textContent = i;
                th.dataset.date = date;
                th.onclick = () => openDetailModal({ line, day, shift, activeFixture });
                headerRow.appendChild(th);
            }

            if (!items.length) {
                body.innerHTML = '<tr><td colspan="34" class="text-center py-4 text-muted">No maintenance items to display</td></tr>';
                return;
            }

            items.forEach((item, idx) => {
                const tr = document.createElement("tr");
                let daysHtml = "";
                const dailyResults = getProp(item, "dailyResults", "DailyResults") || {};

                for (let i = 1; i <= days; i++) {
                    let val = dailyResults[i] || dailyResults[String(i)] || "NA";
                    let text = "",
                        classCell = "";
                    if (val == "OK") {
                        text = `<span class="text-success">${val}</span>`;
                        classCell = `bg-success-subtle-custom`;
                    }
                    if (val == "NG") {
                        text = `<span class="text-warning">${val}</span>`;
                        classCell = `bg-warning-subtle-custom`;
                    }
                    if (val == "NA") {
                        text = `<span>${val}</span>`;
                        classCell = ``;
                    }
                    //daysHtml += `<td class="day-col ${classCell}" onclick="openDetailModal({ line: '${line}', day: ${i}, shift: '${shift}', activeFixture: activeFixture })">${text}</td>`;
                    daysHtml += `<td class="day-col ${classCell}">${text}</td>`;
                }

                const numberOrder = getProp(item, "number_Order", "Number_Order", "numberOrder") || (idx + 1);
                const mtItem = getProp(item, "mT_Item", "MT_Item") || "";
                const mtDesc = getProp(item, "mT_Desc", "MT_Desc") || "";

                tr.innerHTML = `
                    <td class="text-center">${numberOrder}</td>
                    <td>${mtItem}</td>
                    <td>${mtDesc}</td>
                    ${daysHtml}
                `;

                body.appendChild(tr);
            });
        };



        const drawHeaderTableTemp = (thead) => {

            const year = getProp(activeMonthlyData, "year", "Year");
            const month = getProp(activeMonthlyData, "month", "Month");
            const line = getProp(activeMonthlyData, "line", "Line");
            const shift = getProp(activeMonthlyData, "shift", "Shift");

            const deviceName = getProp(activeMonthlyData, "eQ_Name", "EQ_Name") || "";
