        async function uploadImage(fileList) {

            const uploadZones = document.querySelectorAll(".upload-zone");

            try {

                if (fileList.length <= 0) return;

                const file = fileList[0];

                if (!checkImageSize(file)) {
                    Popup.error(`${i18n.imageSizeExceed} ${IMAGE_SIZE} KB. ${i18n.currentSize}: ${(file.size / 1024).toFixed(2)} KB.`);
                    return;
                }

                uploadZones.forEach(upload => {
                    upload.classList.add('disabled');
                });

                Popup.show(`${i18n.processingImage}...`);

                const formData = new FormData();
                formData.append("file", file);

                const result = await ApiClient.postForm('api/fixture/image/getInfo', formData);

                const data = getResponseData(result);

                if (data.code === 200) {
                    Popup.success(i18n.imageProcessedCompleted);
                } else {
                    Popup.error(i18n.failedToProcessImage);
                }

                return data;


            } catch (error) {
                Popup.error(error.message);
            } finally {
                uploadZones.forEach(upload => {
                    upload.classList.remove('disabled');
                });
            }

        }

        const checkImageSize = (file) => {
            const MAX_SIZE = IMAGE_SIZE * 1024; // 500KB

            if (file.size > MAX_SIZE) {
                return false;
            }

            return true;
        }


        function checkImageTime(timestamp, rowId) {

            // Parse chuỗi
            const parts = timestamp.split(" ");

            const timePart = parts[0];
            const datePart = parts[1];

            const timeNow = new Date();

            // Lấy ngày hiện tại
            const currentDay = timeNow.getDate();
            const currentMonth = timeNow.getMonth() + 1;
            const currentYear = timeNow.getFullYear();

            // Lấy ngày từ chuỗi
            const dateArr = datePart.split("/");

            const day = parseInt(dateArr[0]);
            const month = parseInt(dateArr[1]);
            const year = parseInt(dateArr[2]);

            // So sánh ngày
            const sameDate =
                day === currentDay &&
                month === currentMonth &&
                year === currentYear;

            let result = 'NA';
            if (sameDate) {
                // So sánh giờ với 20:00
                if (timePart > "20:00") {
                    result = 'NG';
                } else {
                    result = 'OK';
                }

            } else {
                result = 'NG';
            }

            return result;
        }


        function recalcRowResult(rowId, gallery) {
            const items = gallery.querySelectorAll(".gallery-item");

            let results = [];

            items.forEach(item => {
                if (item._result) {
                    results.push(item._result);
                }
            });

            let finalResult = 'NA';

            if (results.length === 0) {
                finalResult = 'NA';
            } else if (results.includes('NA')) {
                finalResult = 'NA';
            } else if (results.includes('NG')) {
                finalResult = 'NG';
            } else if (results.every(x => x === 'OK')) {
                finalResult = 'OK';
            }

            document.querySelector(
                `input[name="uploader_res_${rowId}"][value="${finalResult}"]`
            ).checked = true;
        }
