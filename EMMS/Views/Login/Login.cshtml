@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="~/Content/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/css/custom/login.css" rel="stylesheet" />
</head>

<body>
    <!-- Main Content -->
    <!-- Background Elements -->
    <div class="bg-animated"></div>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <!-- Header Section -->
    <!-- Main Content -->
    <main class="container flex-grow-1 d-flex align-items-center justify-content-center py-4 min-vh-100">
        <div class="login-card">
            <!-- Welcome Section -->
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-1">@Language.LogIn</h1>
                @*<p class="text-muted small mb-0">Vui lòng đăng nhập để tiếp tục.</p>*@
            </div>
            <!-- Login Form -->
            <form id="loginForm" onsubmit="return false;">
                <!-- Email/Username Input -->
                <div class="mb-3">
                    <label class="form-label" for="username">@Language.Username</label>
                    <div class="position-relative">
                        <span class="material-symbols-outlined input-group-text-overlay">person</span>
                        <input class="form-control" id="username" name="UserId" placeholder="@Language.EnterUsername" type="text" autocomplete="username">
                    </div>
                </div>
                <!-- Password Input -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label class="form-label" for="password">@Language.Password</label>
                    </div>
                    <div class="position-relative">
                        <span class="material-symbols-outlined input-group-text-overlay">lock</span>
                        <input class="form-control" id="password" name="Password" placeholder="@Language.EnterPassword" type="password" autocomplete="current-password">
                        <button class="password-toggle" onclick="togglePasswordVisibility()" type="button">
                            <span class="material-symbols-outlined" id="password-toggle-icon">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Remember & Forgot -->
                @*<div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input class="form-check-input" id="rememberMe" type="checkbox" value="">
                            <label class="form-check-label" for="rememberMe">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>
                        <a class="link-primary" href="#">Quên mật khẩu?</a>
                    </div>*@
                <!-- Primary Submit Button -->
                <div class="alert alert-danger d-none py-2 small" id="loginMessage"></div>
                <button class="btn btn-primary w-100 mb-4" id="loginButton" type="submit">
                    @Language.LogIn
                </button>
            </form>
            <!-- Signup Prompt -->
            <div class="text-center">
                <p class="small text-muted mb-0">
                    @Language.ContactAdmin
                </p>
            </div>
        </div>
    </main>
    <!-- Bootstrap Bundle with Popper -->

    <script src="~/Scripts/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script>
        const i18n = @Html.Raw(Json.Encode(new {
            loggingIn = Language.LoggingIn,
            requireUsernameAndPassword = Language.RequireUsernameAndPassword,
            loginFailed = Language.LoginFailed
        }));

        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('password-toggle-icon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.innerText = 'visibility_off';
            } else {
                passwordInput.type = 'password';
                toggleIcon.innerText = 'visibility';
            }
        }

        const getProp = (obj, ...keys) => {
            if (!obj) return null;

            for (const key of keys) {
                if (Object.prototype.hasOwnProperty.call(obj, key)) {
                    return obj[key];
                }
            }

            return null;
        };

        const showLoginMessage = (message) => {
            const messageEl = document.getElementById('loginMessage');
            messageEl.textContent = message || i18n.loginFailed;
            messageEl.classList.remove('d-none');
        };

        document.getElementById('loginForm').addEventListener('submit', async () => {
            const userId = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            const loginButton = document.getElementById('loginButton');
            const messageEl = document.getElementById('loginMessage');

            messageEl.classList.add('d-none');

            if (!userId || !password) {
                showLoginMessage(i18n.requireUsernameAndPassword);
            }

            const body = new URLSearchParams();
            body.append('Type', 'FATP');
            body.append('UserId', userId);
            body.append('Password', password);

            loginButton.disabled = true;
            loginButton.textContent = `${i18n.loggingIn}...`;

            try {
                const response = await fetch('@Url.Action("SignIn", "Login")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                    },
                    body: body.toString()
                });

                const text = await response.text();
                const result = text ? JSON.parse(text) : null;
                const success = getProp(result, 'success', 'Success') === true;

                if (!response.ok || !success) {
                    showLoginMessage(getProp(result, 'message', 'Message') || i18n.loginFailed);
                    return;
                }

                window.location.href = '@Url.Action("Index", "Home")';
            } catch (error) {
                showLoginMessage(error.message);
            } finally {
                loginButton.disabled = false;
                loginButton.textContent = 'Log in';
            }
        });
    </script>
</body>

</html>