@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewBag.Title = Language.ChangePassword;
}


@section styles {
    <link href="@Url.Content("~/Content/css/custom/change-password.css")" rel="stylesheet" />
}


<main class="flex-grow-1 d-flex flex-column align-items-center justify-content-center py-5">
    <div class="container d-flex flex-column align-items-center">
        <!-- Header -->
        <!--<header class="text-center mb-5">
        <h1 class="headline-lg mb-2">Đổi Mật Khẩu</h1>-->
        @*<p class="text-muted small mb-0" style="max-width: 320px;">
            Vui lòng nhập thông tin bên dưới để cập nhật
            bảo mật cho tài khoản của bạn.
        </p>*@
        <!--</header>-->
        <!-- Form Card -->
        <div class="form-card">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-1">@Language.ChangePassword</h1>
            </div>
            <form id="passwordForm">
                <!-- Current Password -->
                <div class="mb-3">
                    <label class="label-caps" for="username">@Language.Username</label>
                    <input class="form-control" id="username" name="username" placeholder=""
                           type="password" />
                </div>
                <div class="mb-3">
                    <label class="label-caps" for="current_password">@Language.CurrentPassword</label>
                    <input class="form-control" id="current_password" name="current_password" placeholder=""
                           type="password" autocomplete="off" />
                </div>
                <!-- New Password -->
                <div class="mb-3">
                    <label class="label-caps" for="new_password">@Language.NewPassword</label>
                    <input class="form-control" id="new_password" name="new_password" placeholder=""
                           type="password" autocomplete="off" />
                    <!-- Security Indicator Bars -->
                    <div class="row g-1 mt-2" id="strengthBars">
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                    </div>
                    <div class="text-end mt-1">
                        <small class="fst-italic text-muted" id="strengthLabel" style="font-size: 12px;">
                            @Language.Strength: @Language.VeryWeak
                        </small>
                    </div>
                    <!-- Password Validation Checklist -->
                    <ul class="validation-checklist" id="validationChecklist">
                        <li class="validation-item" id="rule-length">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.AtLeast8Characters</span>
                        </li>
                        <li class="validation-item" id="rule-upper">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.UppercaseLetter (A-Z)</span>
                        </li>
                        <li class="validation-item" id="rule-lower">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.LowercaseLetter (a-z)</span>
                        </li>
                        <li class="validation-item" id="rule-number">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.Number (0-9)</span>
                        </li>
                        <li class="validation-item" id="rule-special">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.SpecialCharacter (!#@@$%...)</span>
                        </li>
                    </ul>
                </div>
                <!-- Confirm Password -->
                <div class="mb-3">
                    <label class="label-caps" for="confirm_password">@Language.ConfirmNewPassword</label>
                    <input class="form-control" id="confirm_password" name="confirm_password" placeholder=""
                           type="password" autocomplete="off" />
                </div>
                <!-- CTA -->
                <div class="mt-3 pt-2">
                    <button class="btn btn-aurum w-100" type="submit">@Language.ChangePassword</button>
                </div>
                <!-- Forgot link -->
                <div class="text-center mt-3">
                    <a class="forgot-password" href="/EMMS/">@Language.BackToHome</a>
                </div>
            </form>
        </div>
        <!-- Feedback -->
        <div class="d-none" id="passwordMessage" style="max-width: 480px; width: 100%;">
            <!-- Message -->
        </div>
    </div>
</main>
@section scripts{
    <script>

        const i18n = @Html.Raw(Json.Encode(new {
            changingPassword = Language.ChangingPassword,
            strength = Language.Strength,
            veryWeak = Language.VeryWeak,
            weak = Language.Weak,
            medium = Language.Medium,
            strong = Language.Strong,
            passwordChangedSuccessfully = Language.PasswordChangedSuccessfully,
            failedToChangePassword = Language.FailedToChangePassword
        }));

        const passwordInput = document.getElementById('new_password');
        const strengthBars = document.querySelectorAll('.strength-meter');
        const strengthLabel = document.getElementById('strengthLabel');

        const rules = {
            length: { el: document.getElementById('rule-length'), regex: /.{8,}/ },
            upper: { el: document.getElementById('rule-upper'), regex: /[A-Z]/ },
            lower: { el: document.getElementById('rule-lower'), regex: /[a-z]/ },
            number: { el: document.getElementById('rule-number'), regex: /[0-9]/ },
            special: { el: document.getElementById('rule-special'), regex: /[!#@@$%^&*(),.?":{}|<>]/ }
        };

        function updateValidationUI() {
            const value = passwordInput.value;
            let metCount = 0;

            for (const key in rules) {
                const rule = rules[key];
                const isValid = rule.regex.test(value);

                if (isValid) {
                    rule.el.classList.add('valid');
                    rule.el.querySelector('.material-symbols-outlined').innerText = 'check_circle';
                    metCount++;
                } else {
                    rule.el.classList.remove('valid');
                    rule.el.querySelector('.material-symbols-outlined').innerText = 'circle';
                }
            }

            // Update Strength Bars
            strengthBars.forEach((bar, index) => {
                if (index < metCount - 1) { // Adjusted to start showing bars from 2nd met rule
                    bar.classList.add('active');
                    bar.classList.remove('inactive');
                } else {
                    bar.classList.remove('active');
                    bar.classList.add('inactive');
                }
            });

            // Strength labels based on met criteria
            if (metCount <= 1) strengthLabel.innerText = `${i18n.strength}: ${i18n.veryWeak}`;
            else if (metCount <= 3) strengthLabel.innerText = `${i18n.strength}: ${i18n.weak}`;
            else if (metCount === 4) strengthLabel.innerText = `${i18n.strength}: ${i18n.medium}`;
            else if (metCount === 5) strengthLabel.innerText = `${i18n.strength}: ${i18n.strong}`;
        }

        passwordInput.addEventListener('input', updateValidationUI);

        document.getElementById('passwordForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const passwordMessage = document.getElementById('passwordMessage');

            const btn = e.target.querySelector('button');
            const originalText = btn.innerText;

            btn.innerText = `${i18n.changingPassword}...`;
            btn.disabled = true;
            btn.style.opacity = '0.8';

            passwordMessage.classList.remove('d-none');
            try {
                const result = await ApiClient.post('submit-change-pw');

                const isSuccess = result.isSuccess;

                if (isSuccess) {
                    passwordMessage.textContent = i18n.passwordChangedSuccessfully;
                    passwordMessage.classList.add('success');
                } else {
                    passwordMessage.textContent = i18n.failedToChangePassword;
                    passwordMessage.classList.add('error');
                }
            } catch (error) {
                passwordMessage.textContent = error.message;
                passwordMessage.classList.add('error');
            }
            finally {
                btn.innerText = originalText;
                btn.disabled = false;
                btn.style.opacity = '1';
            }
        });

        // Focus effects for all inputs
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                const label = input.parentElement.querySelector('.label-caps');
                if (label) label.style.color = 'var(--bs-primary)';
            });
            input.addEventListener('blur', () => {
                const label = input.parentElement.querySelector('.label-caps');
                if (label) label.style.color = 'var(--on-surface-variant)';
            });
        });
    </script>
}