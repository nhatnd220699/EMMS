@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewBag.Title = Language.ChangePassword;
    var currentRoleFromSession = (Session["CurrentRole"] ?? "uploader").ToString();
    var currentUserIdFromSession = (Session["UserId"] ?? "").ToString();
    var currentUserNameFromSession = (Session["UserName"] ?? "").ToString();
    var roleFromSession = (Session["Role"] ?? "").ToString();
}


@section styles {
    <link href="@Url.Content("~/Content/css/custom/change-password.css")" rel="stylesheet" />
}


<main class="flex-grow-1 d-flex flex-column align-items-center justify-content-center py-5">
    <div class="container d-flex flex-column align-items-center">
        <!-- Header -->
        <!--<header class="text-center mb-5">
        <h1 class="headline-lg mb-2">Đổi Mật Khẩu</h1>-->
        @*<p class="text-muted small mb-0" style="max-width: 320px;">
            Vui lòng nhập thông tin bên dưới để cập nhật
            bảo mật cho tài khoản của bạn.
        </p>*@
        <!--</header>-->
        <!-- Form Card -->
        <div class="form-card">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold mb-1">@Language.ChangePassword</h1>
            </div>
            <form id="passwordForm" onsubmit="return false;">
                <!-- Current Password -->
                <div class="mb-3">
                    <label class="label-caps" for="user_id">@Language.Username</label>
                    <input class="form-control" id="user_id" name="user_id" placeholder=""
                           type="text" autocomplete="on" />
                </div>
                <div class="mb-3">
                    <label class="label-caps" for="current_password">@Language.CurrentPassword</label>
                    <div class="position-relative">
                        <input class="form-control" id="current_password" name="current_password" placeholder=""
                               type="password" autocomplete="off" />
                        <button class="password-toggle" type="button">
                            <span class="material-symbols-outlined" id="current_password-toggle">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- New Password -->
                <div class="mb-3">
                    <label class="label-caps" for="new_password">@Language.NewPassword</label>
                    <div class="position-relative">
                        <input class="form-control" id="new_password" name="new_password" placeholder=""
                               type="password" autocomplete="off" />
                        <button class="password-toggle" type="button">
                            <span class="material-symbols-outlined" id="new_password-toggle">visibility</span>
                        </button>
                    </div>
                    <!-- Security Indicator Bars -->
                    <div class="row g-1 mt-2" id="strengthBars">
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                        <div class="col">
                            <div class="strength-meter inactive"></div>
                        </div>
                    </div>
                    <div class="text-end mt-1">
                        <small class="fst-italic text-muted" id="strengthLabel" style="font-size: 12px;">
                            @Language.Strength: @Language.VeryWeak
                        </small>
                    </div>
                    <!-- Password Validation Checklist -->
                    <ul class="validation-checklist" id="validationChecklist">
                        <li class="validation-item" id="rule-length">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.AtLeast10Characters</span>
                        </li>
                        <li class="validation-item" id="rule-upper">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.UppercaseLetter (A-Z)</span>
                        </li>
                        <li class="validation-item" id="rule-lower">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.LowercaseLetter (a-z)</span>
                        </li>
                        <li class="validation-item" id="rule-number">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.Number (0-9)</span>
                        </li>
                        <li class="validation-item" id="rule-special">
                            <span class="material-symbols-outlined">circle</span>
                            <span>@Language.SpecialCharacter (!#@@$%...)</span>
                        </li>
                    </ul>
                </div>
                <!-- Confirm Password -->
                <div class="mb-3">
                    <label class="label-caps" for="confirm_password">@Language.ConfirmNewPassword</label>
                    <div class="position-relative">
                        <input class="form-control" id="confirm_password" name="confirm_password" placeholder=""
                               type="password" autocomplete="off" />
                        <button class="password-toggle" type="button">
                            <span class="material-symbols-outlined" id="confirm_password-toggle">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Feedback -->
                <div class="d-none mb-3 small" id="passwordMessage" style="max-width: 480px; width: 100%;">
                    <!-- Message -->
                </div>
                <!-- CTA -->
                <div class="mt-3 pt-2">
                    <button class="btn btn-aurum w-100" type="submit" id="change-password">@Language.ChangePassword</button>
                </div>
                <!-- Forgot link -->
                <div class="text-center mt-3">
                    <a class="forgot-password" href="@Url.Content("~/")">@Language.BackToHome</a>
                </div>
            </form>
        </div>
    </div>
</main>
@section scripts{
    <script>
        const CURRENT_USER_ID = "@HttpUtility.JavaScriptStringEncode(currentUserIdFromSession)";

        const i18n = @Html.Raw(Json.Encode(new {
            changingPassword = Language.ChangingPassword,
            strength = Language.Strength,
            veryWeak = Language.VeryWeak,
            weak = Language.Weak,
            medium = Language.Medium,
            strong = Language.Strong,
            passwordChangedSuccessfully = Language.PasswordChangedSuccessfully,
            failedToChangePassword = Language.FailedToChangePassword,
            atLeast10Characters = Language.AtLeast10Characters,
            uppercaseLetter = Language.UppercaseLetter,
            lowercaseLetter = Language.LowercaseLetter,
            number = Language.Number,
            specialCharacter = Language.SpecialCharacter,
            passwordConfirmationNotMatch = Language.PasswordConfirmationNotMatch,
            theFieldsIsRequired = Language.TheFieldsIsRequired
        }));

        const userInput = document.getElementById('user_id');
        const passwordInput = document.getElementById('new_password');
        const strengthBars = document.querySelectorAll('.strength-meter');
        const strengthLabel = document.getElementById('strengthLabel');

        userInput.value = CURRENT_USER_ID || '';

        const rules = {
            length: { el: document.getElementById('rule-length'), regex: /.{10,}/ },
            upper: { el: document.getElementById('rule-upper'), regex: /[A-Z]/ },
            lower: { el: document.getElementById('rule-lower'), regex: /[a-z]/ },
            number: { el: document.getElementById('rule-number'), regex: /[0-9]/ },
            special: { el: document.getElementById('rule-special'), regex: /[!#@@$%^&*(),.?":{}|<>]/ }
        };

        function updateValidationUI() {
            const value = passwordInput.value;
            let metCount = 0;

            for (const key in rules) {
                const rule = rules[key];
                const isValid = rule.regex.test(value);

                if (isValid) {
                    rule.el.classList.add('valid');
                    rule.el.querySelector('.material-symbols-outlined').innerText = 'check_circle';
                    metCount++;
                } else {
                    rule.el.classList.remove('valid');
                    rule.el.querySelector('.material-symbols-outlined').innerText = 'circle';
                }
            }

            // Update Strength Bars
            strengthBars.forEach((bar, index) => {
                if (index < metCount - 1) { // Adjusted to start showing bars from 2nd met rule
                    bar.classList.add('active');
                    bar.classList.remove('inactive');
                } else {
                    bar.classList.remove('active');
                    bar.classList.add('inactive');
                }
            });

            // Strength labels based on met criteria
            if (metCount <= 1) strengthLabel.innerText = `${i18n.strength}: ${i18n.veryWeak}`;
            else if (metCount <= 3) strengthLabel.innerText = `${i18n.strength}: ${i18n.weak}`;
            else if (metCount === 4) strengthLabel.innerText = `${i18n.strength}: ${i18n.medium}`;
            else if (metCount === 5) strengthLabel.innerText = `${i18n.strength}: ${i18n.strong}`;
        }


        // Focus effects for all inputs
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', () => {
                const label = input.parentElement.querySelector('.label-caps');
                if (label) label.style.color = 'var(--bs-primary)';
            });
            input.addEventListener('blur', () => {
                const label = input.parentElement.querySelector('.label-caps');
                if (label) label.style.color = 'var(--on-surface-variant)';
            });
        });

        passwordInput.addEventListener('input', updateValidationUI);



        function validatePassword(password) {

            const errors = [];

            if (password.length < 10) {
                errors.push(i18n.atLeast10Characters);
            }

            if (!/[A-Z]/.test(password)) {
                errors.push(`${i18n.uppercaseLetter} (A-Z)`);
            }

            if (!/[a-z]/.test(password)) {
                errors.push(`${i18n.lowercaseLetter} (a-z)`);
            }

            if (!/[0-9]/.test(password)) {
                errors.push(`${i18n.number} (0-9)`);
            }

            if (!/[!@@#$%^&*(),.?":{}|<>]/.test(password)) {
                errors.push(`${i18n.specialCharacter} (!#@@$%...)`);
            }

            return errors;
        }

        document.getElementById('passwordForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const passwordMessage = document.getElementById('passwordMessage');

            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.innerText;

            btn.innerText = `${i18n.changingPassword}...`;
            btn.disabled = true;
            btn.style.opacity = '0.8';

            try {
                const userId = document.getElementById('user_id').value.trim() || '';
                const currentPassword = document.getElementById('current_password').value.trim();
                const newPassword = document.getElementById('new_password').value.trim();
                const confirmPassword = document.getElementById('confirm_password').value.trim();

                if (!userId || !currentPassword || !newPassword || !confirmPassword) {
                    Popup.error(i18n.theFieldsIsRequired);
                    return;
                }

                // Kiểm tra độ mạnh mật khẩu
                const validationErrors = validatePassword(newPassword);

                if (validationErrors.length > 0) {
                    Popup.error(validationErrors.join('<br/>'));
                    return;
                }

                // Kiểm tra xác nhận mật khẩu
                if (newPassword !== confirmPassword) {
                    Popup.error(i18n.passwordConfirmationNotMatch);
                    return;
                }

                const params = {
                    type: '',
                    userId,
                    currentPassword,
                    newPassword,
                    confirmPassword
                }

                const result = await ApiClient.post('@Url.Action("SaveChangePasssword", "Auth")', params);

                const isSuccess = result.Success;

                passwordMessage.classList.remove('d-none');

                if (isSuccess) {
                    passwordMessage.textContent = i18n.passwordChangedSuccessfully;
                    passwordMessage.classList.add('success');
                    passwordMessage.classList.remove('error');

                } else {
                    passwordMessage.textContent = result.Message;
                    passwordMessage.classList.add('error');
                    passwordMessage.classList.remove('success');
                }
            } catch (error) {

                passwordMessage.textContent = error.message;
                passwordMessage.classList.remove('d-none', 'success');
                passwordMessage.classList.add('error');
                passwordMessage.classList.remove();

            }
            finally {

                btn.innerText = originalText;
                btn.disabled = false;
                btn.style.opacity = '1';

            }
        });


        function togglePasswordVisibility(inputId, icon) {
            const inputEle = document.getElementById(inputId);
            const toggleIcon = document.getElementById(icon);

            if (inputEle.type === 'password') {
                inputEle.type = 'text';
                toggleIcon.innerText = 'visibility_off';
            } else {
                inputEle.type = 'password';
                toggleIcon.innerText = 'visibility';
            }
        }

        document.getElementById('current_password-toggle').addEventListener('click', function (e) {
            togglePasswordVisibility('current_password', 'current_password-toggle');
        });

        document.getElementById('new_password-toggle').addEventListener('click', function (e) {
            togglePasswordVisibility('new_password', 'new_password-toggle');
        });

        document.getElementById('confirm_password-toggle').addEventListener('click', function (e) {
            togglePasswordVisibility('confirm_password', 'confirm_password-toggle');
        });
    </script>
}