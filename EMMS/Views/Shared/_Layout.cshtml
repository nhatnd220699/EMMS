<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/css/custom/popup.css" rel="stylesheet" />

    @RenderSection("styles", required: false)
</head>
<body>
    @Html.Partial("_Navbar")
    <div id="wrapper">
        @Html.Partial("_Sidebar")
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/Common/helper.js"></script>
    <script src="~/Scripts/Common/utils.js"></script>
    <script src="~/Scripts/Common/popup.js"></script>
    <script src="~/Scripts/common/action-lock.js"></script>

    <script src="~/Scripts/api/api-client.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
